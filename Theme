/* IMPORTANT: make sure to enable dark mode in discord settings for the theme to apply properly!!! */

@import url('https://refact0r.github.io/midnight-discord/archive/midnight.css');
@import 'local.css';

/* customize things here */
:root {
    /* font, change to 'gg sans' for default discord font*/
    --font: 'figtree';

    /* top left corner text */
    --corner-text: 'Midnight';

    /* color of status indicators and window controls */
    --online-indicator: hsl(95 100% 38%); 
    --dnd-indicator: hsl(360 100% 43.6%); 
    --idle-indicator: hsl(58 100% 60%); 
    --streaming-indicator: hsl(294 100% 60%); 

    /* accent colors */
    --accent-1: hsl(226 98.9% 42.7%); /* links */
    --accent-2: hsl(13 70% 48%); /* general unread/mention elements */
    --accent-3: hsl(230 70% 24.6%); /* accent buttons */
    --accent-4: hsl(230 70% 45.4%); /* accent buttons when hovered */
    --accent-5: hsl(230 70% 17.2%); /* accent buttons when clicked */
    --mention: hsla(360 82% 53.9% / 0.17); /* mentions & mention messages */
    --mention-hover: hsla(36 100% 52% / 0.29); /* mentions & mention messages when hovered */

    /* text colors */
    --text-0: white; /* text on colored elements */
    --text-1: var(--text-2); /* other normally white text */
    --text-2: hsl(242 100% 51%); /* headings and important text */
    --text-3: hsla(213 100% 39.2% / 0.99); /* normal text */
    --text-4: hsla(255 100% 47.1% / 0.99); /* icon buttons and channels */
    --text-5: hsla(360 100% 54.9% / 0.41); /* muted channels/chats and timestamps */

    /* background and dark colors */
    --bg-1: hsla(220 15% 100% / 0.79); /* dark buttons when clicked */
    --bg-2: hsla(220 15% 57.6% / 0.79); /* dark buttons */
    --bg-3: hsl(220 15% 24.3%); /* spacing, secondary elements */
    --bg-4: hsl(220 15% 0%); /* main background color */
    --hover: hsl(177 34.1% 23.6%); /* channels and buttons when hovered */
    --active: hsl(117 79.6% 28.2%); /* channels and buttons when clicked or selected */
    --message-hover: hsla(171 90.1% 86.7% / 0.69); /* messages when hovered */

    /* amount of spacing and padding */
    --spacing: 8px;

    /* animations */
    /* ALL ANIMATIONS CAN BE DISABLED WITH REDUCED MOTION IN DISCORD SETTINGS */
    --list-item-transition: 0.2s ease; /* channels/members/settings hover transition */
    --unread-bar-transition: 0.2s ease; /* unread bar moving into view transition */
    --moon-spin-transition: 0.4s ease; /* moon icon spin */
    --icon-spin-transition: 1s ease; /* round icon button spin (settings, emoji, etc.) */

    /* corner roundness (border-radius) */
    --roundness-xl: 22px; /* roundness of big panel outer corners */
    --roundness-l: 20px; /* popout panels */
    --roundness-m: 16px; /* smaller panels, images, embeds */
    --roundness-s: 12px; /* members, settings inputs */
    --roundness-xs: 10px; /* channels, buttons */
    --roundness-xxs: 8px; /* searchbar, small elements */

    /* direct messages moon icon */
    /* change to block to show, none to hide */
    --discord-icon: none; /* discord icon */
    --moon-icon: block; /* moon icon */
    --moon-icon-url: url('https://devforum-uploads.s3.dualstack.us-east-2.amazonaws.com/uploads/original/4X/e/a/9/ea98f8c6c438d2d8136a6751282a153c6b28b892.png'); /* custom icon url */
    --moon-icon-size: auto;

    /* filter uncolorable elements to fit theme */
    /* (just set to none, they're too much work to configure) */
    --login-bg-filter: saturate(0.3) hue-rotate(-15deg) brightness(0.4); /* login background artwork */
    --green-to-accent-3-filter: hue-rotate(56deg) saturate(1.43); /* add friend page explore icon */
    --blurple-to-accent-3-filter: hue-rotate(304deg) saturate(0.84) brightness(1.2); /* add friend page school icon */

    /* nav buttons */
    --windows-nav: none;
    --custom-nav: block;
}
